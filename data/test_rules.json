    "severity": "low",
    "note": "测试MD5匹配 - hello字符串"
  },
  {
    "id": "test_path_regex_temp",
    "family": "测试家族",
    "match": [
      {
        "field": "image_path",
        "type": "regex",
        "value": "temp\\d{3,}\\.exe$"
      }
    ],
    "severity": "medium",
    "note": "测试路径正则 - 匹配temp目录下数字命名的exe"
  },
  {
    "id": "test_command_regex_http",
    "family": "测试家族",
    "match": [
      {
        "field": "command_line",
        "type": "regex",
        "value": "https?://[\\w\\.-]+"
      }
    ],
    "severity": "medium",
    "note": "测试命令行正则 - 匹配HTTP/HTTPS URL"
  }
