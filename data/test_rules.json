[
  {
    "id": "silverfox_rundll_obfuscation",
    "family": "银狐",
    "match": [
      {
        "field": "command_line",
        "type": "regex",
        "value": "\\\"{2,}u\\\"{2,}n\\\"{2,}d\\\"{2,}ll\\\"{2,}32"
      }
    ],
    "severity": "high",
    "note": "rundll32双引号混淆调用检测 - 匹配如 r\"\"u\"\"n\"\"d\"\"ll\"\"32 形式"
  },
  {
    "id": "silverfox_jnetpub_path",
    "family": "银狐",
    "match": [
      {
        "field": "image_path",
        "type": "contains",
        "value": "jnetpub"
      }
    ],
    "severity": "high",
    "note": "银狐常见路径特征 - image_path 包含 jnetpub"
  },
  {
    "id": "silverfox_jnetpub_cmd",
    "family": "银狐",
