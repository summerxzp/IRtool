        "value": "223.5.5.5"
      }
    ],
    "severity": "low",
    "note": "测试IP匹配 - 阿里云DNS"
  },
  {
    "id": "test_ip_8_8_8_8",
    "family": "测试家族",
    "match": [
      {
        "field": "ip",
        "type": "equals",
        "value": "8.8.8.8"
      }
    ],
    "severity": "low",
    "note": "测试IP匹配 - Google DNS"
  },
  {
    "id": "test_sha256_empty",
    "family": "测试家族",
    "match": [
      {
        "field": "sha256",
        "type": "equals",
        "value": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
      }
    ],
    "severity": "low",
    "note": "测试SHA256匹配 - 空文件hash"
  },
  {
    "id": "test_md5_hello",
    "family": "测试家族",
    "match": [
      {
        "field": "md5",
        "type": "equals",
        "value": "5d41402abc4b2a76b9719d911017c592"
      }
